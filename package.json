{
  "name": "sportbets",
  "version": "1.0.0",
  "private": true,
  "description": "Fetches daily odds data from The Odds API and stores it in SQLite",
  "main": "src/index.js",
  "scripts": {
    "fetch:odds": "node src/index.js",
    "export:edge": "node src/exportEdgeCandidates.js",
    "table:upcoming": "node src/printUpcomingTable.js",
    "fetch:odds:50": "set ODDS_API_MAX_CALLS=50&& node src/index.js",
    "fetch:polymarket": "node src/fetchPolymarketEvents.js",
    "list:polymarket:types": "node src/listPolymarketBetTypes.js",
    "map:polymarket": "node src/polymarketMapper.js",
    "compare:polymarket": "node src/comparePolymarketOdds.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5"
  }
}
